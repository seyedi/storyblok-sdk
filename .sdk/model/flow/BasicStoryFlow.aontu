# BasicStoryFlow

main: kit: flow: BasicStoryFlow:
{
  entity: "story",
  kind: "basic",
  name: "BasicStoryFlow",
  step: [
    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "story_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "story_ref01",
        srcdatavar: "story_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "story01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-story_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicStoryFlow"
}