      servers: [
        {
          description: "European Union"
          url: "https://api.storyblok.com"
        }
        {
          description: "United States"
          url: "https://api-us.storyblok.com"
        }
        {
          description: "Canada"
          url: "https://api-ca.storyblok.com"
        }
        {
          description: "Australia"
          url: "https://api-au.storyblok.com"
        }
        {
          description: "China"
          url: "https://app.storyblokchina.cn"
        }
      ]
      summary: "CDN endpoints for your Storyblok space"
      title: "Storyblok Content Delivery API"
      version: "v2"
      website: "https://www.storyblok.com/docs/api/content-delivery/v2"
    }
